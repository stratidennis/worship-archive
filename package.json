{
  "name": "worship-archive",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first worship song manager for bands \u2014 browser + Electron, LAN-hosted",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "dev": "concurrently -n server,ui -c blue,green \"pnpm --filter @worship/server dev\" \"pnpm --filter @worship/ui dev\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "pnpm --filter @worship/tools migrate",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "dev:server": "pnpm --filter @worship/server dev",
    "dev:ui": "pnpm --filter @worship/ui dev",
    "dev:desktop": "pnpm --filter @worship/ui build && pnpm --filter @worship/desktop dev",
    "abi:node": "node tools/src/native-abi.mjs node",
    "abi:electron": "node tools/src/native-abi.mjs electron",
    "smoke:desktop": "node packages/desktop/scripts/smoke.mjs",
    "dist:desktop": "pnpm --filter @worship/desktop dist:leader",
    "dist:leader": "pnpm --filter @worship/desktop dist:leader",
    "dist:band": "pnpm --filter @worship/desktop dist:band",
    "dist:stage": "pnpm --filter @worship/desktop dist:stage",
    "icons": "python3 tools/src/make-icons.py",
    "trace:logo": "python3 tools/src/trace-logo.py"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  }
}
